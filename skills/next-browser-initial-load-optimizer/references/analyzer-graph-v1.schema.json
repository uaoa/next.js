{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nextjs:analyze:analyzer-graph:v1",
  "title": "Next.js analyzer graph v1 record",
  "description": "Validate one JSON object per NDJSON line. Stream ordering, completeness, and cross-record joins are separate checks described in SKILL.md. Unknown additive fields on known records are allowed.",
  "oneOf": [
    { "$ref": "#/$defs/meta" },
    { "$ref": "#/$defs/module" },
    { "$ref": "#/$defs/route" },
    { "$ref": "#/$defs/output" },
    { "$ref": "#/$defs/part" },
    { "$ref": "#/$defs/unjoined" },
    { "$ref": "#/$defs/group" },
    { "$ref": "#/$defs/load_edge" },
    { "$ref": "#/$defs/unresolved" }
  ],
  "$defs": {
    "index": { "type": "integer", "minimum": 0 },
    "size": { "type": "number", "minimum": 0 },
    "identity": { "type": "string" },
    "meta": {
      "type": "object",
      "required": [
        "type",
        "schema_version",
        "snapshot_id",
        "module_index_hash",
        "route_count",
        "selected_routes"
      ],
      "properties": {
        "type": { "const": "meta" },
        "schema_version": { "const": 1 },
        "snapshot_id": { "type": "string" },
        "module_index_hash": { "type": ["string", "null"] },
        "route_count": { "$ref": "#/$defs/index" },
        "selected_routes": { "$ref": "#/$defs/index" }
      },
      "additionalProperties": true
    },
    "module": {
      "type": "object",
      "required": ["type", "ident", "path", "dependencies"],
      "properties": {
        "type": { "const": "module" },
        "ident": { "$ref": "#/$defs/identity" },
        "path": { "type": "string" },
        "dependencies": {
          "type": "object",
          "required": ["sync", "async", "traced"],
          "properties": {
            "sync": { "$ref": "#/$defs/identities" },
            "async": { "$ref": "#/$defs/identities" },
            "traced": { "$ref": "#/$defs/identities" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "identities": {
      "type": "array",
      "items": { "$ref": "#/$defs/identity" }
    },
    "clientReference": {
      "type": "object",
      "required": ["module_ident", "module_path", "reference_kind"],
      "properties": {
        "module_ident": { "$ref": "#/$defs/identity" },
        "module_path": { "type": "string" },
        "reference_kind": { "type": "string" }
      },
      "additionalProperties": true
    },
    "entry": {
      "type": "object",
      "required": [
        "route_entry_id",
        "module_ident",
        "module_path",
        "role",
        "entry_kind",
        "client_references"
      ],
      "properties": {
        "route_entry_id": { "type": "string" },
        "module_ident": { "$ref": "#/$defs/identity" },
        "module_path": { "type": "string" },
        "role": { "type": "string" },
        "runtime": { "type": ["string", "null"] },
        "entry_kind": { "type": ["string", "null"] },
        "client_references": {
          "type": "array",
          "items": { "$ref": "#/$defs/clientReference" }
        }
      },
      "additionalProperties": true
    },
    "route": {
      "type": "object",
      "required": ["type", "route", "route_index", "entries", "coverage"],
      "properties": {
        "type": { "const": "route" },
        "route": { "type": "string" },
        "route_index": { "$ref": "#/$defs/index" },
        "entries": {
          "oneOf": [
            { "type": "null" },
            { "type": "array", "items": { "$ref": "#/$defs/entry" } }
          ]
        },
        "coverage": {
          "type": "object",
          "required": ["entries", "groups", "load_edges"],
          "properties": {
            "entries": { "enum": ["exact", "unknown"] },
            "groups": { "enum": ["exact", "unknown"] },
            "load_edges": { "enum": ["exact", "unknown"] }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "output": {
      "type": "object",
      "required": [
        "type",
        "route",
        "route_index",
        "filename",
        "modules",
        "coverage",
        "unresolved_references"
      ],
      "properties": {
        "type": { "const": "output" },
        "route": { "type": "string" },
        "route_index": { "$ref": "#/$defs/index" },
        "filename": { "type": "string" },
        "modules": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/identities" }]
        },
        "coverage": {
          "enum": ["exact", "unsupported", "not_a_chunk", "unknown"]
        },
        "unresolved_references": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/index" }]
        }
      },
      "additionalProperties": true
    },
    "part": {
      "type": "object",
      "required": [
        "type",
        "route",
        "route_index",
        "filename",
        "source_path",
        "size",
        "compressed_size"
      ],
      "properties": {
        "type": { "const": "part" },
        "route": { "type": "string" },
        "route_index": { "$ref": "#/$defs/index" },
        "filename": { "type": "string" },
        "source_path": { "type": "string" },
        "size": { "$ref": "#/$defs/size" },
        "compressed_size": { "$ref": "#/$defs/size" }
      },
      "additionalProperties": true
    },
    "unjoined": {
      "type": "object",
      "required": [
        "type",
        "route",
        "route_index",
        "filename",
        "module_ident",
        "reason"
      ],
      "properties": {
        "type": { "const": "unjoined" },
        "route": { "type": "string" },
        "route_index": { "$ref": "#/$defs/index" },
        "filename": { "type": "string" },
        "module_ident": { "$ref": "#/$defs/identity" },
        "reason": { "type": "string" }
      },
      "additionalProperties": true
    },
    "group": {
      "type": "object",
      "required": [
        "type",
        "route",
        "route_index",
        "id",
        "kind",
        "trigger_module_ident",
        "trigger_join",
        "outputs"
      ],
      "properties": {
        "type": { "const": "group" },
        "route": { "type": "string" },
        "route_index": { "$ref": "#/$defs/index" },
        "id": { "$ref": "#/$defs/index" },
        "kind": { "type": "string" },
        "trigger_module_ident": { "type": ["string", "null"] },
        "trigger_join": { "enum": ["joined", "unjoined", "none"] },
        "outputs": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "load_edge": {
      "type": "object",
      "required": [
        "type",
        "route",
        "route_index",
        "source_output",
        "target_output",
        "kind",
        "trigger_module_ident",
        "trigger_join"
      ],
      "properties": {
        "type": { "const": "load_edge" },
        "route": { "type": "string" },
        "route_index": { "$ref": "#/$defs/index" },
        "source_output": { "type": "string" },
        "target_output": { "type": "string" },
        "kind": { "type": "string" },
        "trigger_module_ident": { "type": ["string", "null"] },
        "trigger_join": { "enum": ["joined", "unjoined", "none"] }
      },
      "additionalProperties": true
    },
    "unresolved": {
      "type": "object",
      "required": [
        "type",
        "route",
        "route_index",
        "source_output",
        "target_path",
        "kind",
        "reason",
        "trigger_module_ident"
      ],
      "properties": {
        "type": { "const": "unresolved" },
        "route": { "type": "string" },
        "route_index": { "$ref": "#/$defs/index" },
        "source_output": { "type": ["string", "null"] },
        "target_path": { "type": "string" },
        "kind": { "type": "string" },
        "reason": { "type": "string" },
        "trigger_module_ident": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    }
  }
}
